    "data_export_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ نسخة احتياطية بصيغة .paralist يمكنك مشاركتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": ".paralist ফাইল হিসেবে একটি ব্যাকআপ তৈরি করে যা আপনি শেয়ার করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine Sicherung als .paralist-Datei, die du teilen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a backup as a .paralist file you can share."
