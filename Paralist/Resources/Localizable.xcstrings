        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un espacio libre de la lista para añadir una nueva nota. Para tareas, eventos y todo lo demás, toca «Crear» abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un espace libre de la liste pour ajouter une nouvelle note. Pour les tâches, les événements et tout le reste, touche « Créer » en bas."
