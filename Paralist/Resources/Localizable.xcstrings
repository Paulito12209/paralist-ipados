            "state": "translated",
            "value": "يمكن استعادة الإدخالات المحذوفة خلال 30 يومًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলা এন্ট্রি ৩০ দিন পর্যন্ত ফিরিয়ে আনা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Einträge bleiben 30 Tage wiederherstellbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted entries can be restored for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas eliminadas se pueden restaurar durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées supprimées restent récupérables pendant 30 jours."
