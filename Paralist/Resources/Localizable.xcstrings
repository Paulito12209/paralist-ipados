    "settings_lock_screen_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف: تعرض شاشة القفل «Paralist · تذكير» فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ: লক স্ক্রিনে শুধু “Paralist · রিমাইন্ডার” দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Der Sperrbildschirm zeigt nur „Paralist · Erinnerung“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the lock screen only shows “Paralist · Reminder”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagado: la pantalla de bloqueo solo muestra «Paralist · Recordatorio»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : l’écran de verrouillage n’affiche que « Paralist · Rappel »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद: लॉक स्क्रीन केवल “Paralist · रिमाइंडर” दिखाती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：锁屏只显示“Paralist · 提醒”。"
          }
