    "settings_rebuild_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد قراءة كل الملفات إذا بدا البحث أو القوائم غير صحيحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোঁজ বা তালিকা ঠিক না থাকলে সব ফাইল আবার পড়ে।"
          }
