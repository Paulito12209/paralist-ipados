    "overview_tabs_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتغيير الترتيب، والعين تخفي علامة التبويب، والقلم يعيد تسميتها. تبقى علامة واحدة على الأقل ظاهرة. يمكن إخفاء «المميّزة» و«القوائم» فقط، أما علاماتك فيمكن حذفها أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রম বদলাতে টানুন, চোখ ট্যাব লুকায়, পেন্সিল নাম বদলায়। অন্তত একটি ট্যাব দেখা যায়। চিহ্নিত ও তালিকা শুধু লুকানো যায়, নিজের ট্যাব মুছেও ফেলা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen ändert die Reihenfolge, das Auge blendet einen Tab aus, der Stift benennt ihn um. Mindestens ein Tab bleibt sichtbar. Markiert und Listen lassen sich nur ausblenden, eigene Tabs auch löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder, the eye hides a tab, the pencil renames it. At least one tab stays visible. Marked and Lists can only be hidden, your own tabs can also be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para ordenar; el ojo oculta una pestaña y el lápiz la renombra. Siempre queda al menos una visible. Marcado y Listas solo se pueden ocultar; las pestañas propias también se pueden eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour ordonner ; l’œil masque un onglet, le crayon le renomme. Au moins un onglet reste visible. Marqué et Listes peuvent seulement être masqués, vos onglets peuvent aussi être supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें, आंख टैब छिपाती है, पेंसिल नाम बदलती है। कम से कम एक टैब दिखता रहता है। चिह्नित और सूचियां केवल छिपाई जा सकती हैं, अपने टैब हटाए भी जा सकते हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可排序，眼睛图标隐藏标签页，铅笔图标重命名。至少保留一个可见。“已标记”和“列表”只能隐藏，自建标签页也可删除。"
          }
        }
      }
    },
