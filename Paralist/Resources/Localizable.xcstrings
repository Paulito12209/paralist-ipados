    "chat_unavailable_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الدردشة إلى جهاز يدعم Apple Intelligence. يمكنك قراءة دردشاتك هنا، لكن لن تحصل على ردود جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাটের জন্য Apple Intelligence সমর্থিত ডিভাইস দরকার। এখানে তুমি চ্যাট পড়তে পারো, কিন্তু নতুন উত্তর পাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat braucht ein Gerät mit Apple Intelligence. Hier kannst du deine Chats lesen, aber keine neuen Antworten bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat needs a device with Apple Intelligence. You can read your chats here, but you won’t get new replies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat necesita un dispositivo con Apple Intelligence. Aquí puedes leer tus chats, pero no recibirás respuestas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat nécessite un appareil compatible Apple Intelligence. Tu peux lire tes chats ici, mais tu ne recevras pas de nouvelles réponses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट के लिए Apple Intelligence वाला डिवाइस चाहिए। यहाँ आप अपनी चैट पढ़ सकते हैं, लेकिन नए जवाब नहीं मिलेंगे।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天需要支持 Apple 智能的设备。你可以在这里查看聊天，但不会收到新的回复。"
          }
        }
      }
    },
    "chat_unavailable_loading": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال النموذج اللغوي قيد التحميل. قد يستغرق ذلك بعض الوقت بعد تشغيل Apple Intelligence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষা মডেল এখনও লোড হচ্ছে। Apple Intelligence চালু করার পর এতে কিছুটা সময় লাগতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell wird noch geladen. Das kann nach dem Einschalten von Apple Intelligence eine Weile dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is still loading. This can take a while after turning on Apple Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de lenguaje aún se está cargando. Puede tardar un rato después de activar Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de langage est encore en cours de chargement. Cela peut prendre un moment après l’activation d’Apple Intelligence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा मॉडल अभी लोड हो रहा है। Apple Intelligence चालू करने के बाद इसमें कुछ समय लग सकता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言模型仍在加载。打开 Apple 智能后可能需要一段时间。"
          }
        }
      }
    },
    "chat_unavailable_off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence متوقف. شغّله من الإعدادات › Apple Intelligence وSiri وستبدأ الدردشة بالرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ আছে। সেটিংস › Apple Intelligence ও Siri থেকে চালু করো, তাহলে চ্যাট উত্তর দেবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist ausgeschaltet. Schalte es unter Einstellungen › Apple Intelligence & Siri ein, dann antwortet der Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is turned off. Turn it on in Settings › Apple Intelligence & Siri and the chat will reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes › Apple Intelligence y Siri y el chat responderá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages › Apple Intelligence et Siri pour que le chat réponde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है। सेटिंग्स › Apple Intelligence और Siri में इसे चालू करें, फिर चैट जवाब देगी।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能已关闭。在“设置 › Apple 智能与 Siri”中打开后，聊天即可回复。"
          }
        }
      }
    },
