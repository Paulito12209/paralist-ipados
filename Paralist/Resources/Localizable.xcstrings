      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لعرض القائمة في علامة التبويب. اضغط مطولًا واسحب للترتيب، واسحب لليسار للإزالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাবে তালিকা দেখাতে ট্যাপ করুন। সাজাতে চেপে ধরে টানুন, সরাতে বাঁয়ে সোয়াইপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zeigt die Liste im Tab. Halten und ziehen ordnet, nach links wischen entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show the list in the tab. Hold and drag to reorder, swipe left to remove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para mostrar la lista en la pestaña. Mantén y arrastra para ordenar, desliza a la izquierda para quitar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour afficher la liste dans l’onglet. Maintenez et faites glisser pour ordonner, balayez vers la gauche pour retirer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैब में सूची दिखाने के लिए टैप करें। क्रम बदलने के लिए दबाकर खींचें, हटाने के लिए बाईं ओर स्वाइप करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可在标签页中显示该列表。按住拖动可排序，向左轻扫可移除。"
          }
        }
      }
    },
