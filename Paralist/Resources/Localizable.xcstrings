    "settings_learning_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى لعدد البطاقات الجديدة للدراسة كل يوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন পড়ার জন্য নতুন কার্ডের সর্বোচ্চ সংখ্যা।"
