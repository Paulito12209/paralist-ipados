    "settings_exact_off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون الإذن قد تتأخر التذكيرات. المس للسماح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি ছাড়া রিমাইন্ডার দেরিতে আসতে পারে। অনুমতি দিতে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Freigabe können sich Erinnerungen verspäten. Tippen zum Erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without permission, reminders may arrive late. Tap to allow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso, los recordatorios pueden retrasarse. Toca para permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans autorisation, les rappels peuvent arriver en retard. Touchez pour autoriser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति के बिना रिमाइंडर देर से आ सकते हैं। अनुमति देने के लिए टैप करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权时，提醒可能会延迟。点按以允许。"
          }
        }
      }
    },
    "settings_exact_on": {
      "extractionState": "manual",
      "localizations": {
