    "siri_new_event_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ موعدًا. يفهم Paralist التاريخ والوقت مما تقوله، مثلًا «طبيب الأسنان غدًا الساعة 8»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপয়েন্টমেন্ট তৈরি করে। Paralist আপনার কথা থেকে তারিখ ও সময় বোঝে, যেমন „কাল ৮টায় দাঁতের ডাক্তার“।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt einen Termin an. Datum und Uhrzeit erkennt Paralist aus dem Gesagten, zum Beispiel „morgen 8 Uhr Zahnarzt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an event. Paralist reads the date and time from what you say, for example “dentist tomorrow at 8”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cita. Paralist entiende la fecha y la hora de lo que dices, por ejemplo «dentista mañana a las 8»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un rendez-vous. Paralist comprend la date et l’heure de ce que tu dis, par exemple « dentiste demain à 8 h »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपॉइंटमेंट बनाता है। Paralist आपकी बात से तारीख और समय पहचानता है, जैसे „कल 8 बजे डेंटिस्ट“।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建日程。Paralist 会从你说的话中识别日期和时间，例如“明天8点看牙医”。"
          }
        }
      }
    },
