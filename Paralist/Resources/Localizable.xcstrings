    "siri_ask_termin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى وماذا؟ مثلًا: طبيب الأسنان غدًا الساعة 8."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখন আর কী? যেমন: কাল ৮টায় দাঁতের ডাক্তার।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann und was? Zum Beispiel: morgen 8 Uhr Zahnarzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When and what? For example: dentist tomorrow at 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo y qué? Por ejemplo: dentista mañana a las 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand et quoi ? Par exemple : dentiste demain à 8 h."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कब और क्या? जैसे: कल 8 बजे डेंटिस्ट।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么时间，什么事？例如：明天8点看牙医。"
          }
        }
      }
    },
