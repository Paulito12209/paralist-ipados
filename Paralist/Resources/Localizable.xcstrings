    "overview_tab_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة التبويب هذه فارغة بعد. أضف قوائم أو إدخالات عبر «تبديل القائمة» على الحافة اليمنى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ট্যাব এখনও খালি। ডান প্রান্তের “তালিকা বদলান” দিয়ে তালিকা বা এন্ট্রি যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tab ist noch leer. Über „Liste wechseln“ am rechten Rand fügst du Listen oder Einträge hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab is still empty. Use “Switch list” at the right edge to add lists or entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pestaña aún está vacía. Con «Cambiar lista» en el borde derecho añades listas o entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet onglet est encore vide. Ajoutez des listes ou des entrées avec « Changer de liste » sur le bord droit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टैब अभी खाली है। दाहिने किनारे पर “सूची बदलें” से सूचियां या प्रविष्टियां जोड़ें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签页还是空的。通过右侧边缘的“切换列表”添加列表或条目。"
          }
        }
      }
    },
