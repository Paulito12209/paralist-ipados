    "siri_new_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ ملاحظة أو مهمة أو مشروعاً أو مجال عمل أو مستنداً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোট, কাজ, প্রজেক্ট, কর্মক্ষেত্র বা ডকুমেন্ট তৈরি করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt eine Notiz, Aufgabe, ein Projekt, einen Arbeitsbereich oder ein Dokument an."
          }
        },
        "en": {
