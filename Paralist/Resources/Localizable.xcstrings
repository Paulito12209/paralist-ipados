    "cover_ratio_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للصورة أو الفيديو نسبة أبعاد مختلفة عن هذه المساحة (16:9)، مثل 4:3 أو الوضع الطولي. حتى لا يُقص شيء تبقى مساحة فارغة. يعرض ملء الشاشة كل شيء. كيف يجب أن تبدو المساحة الفارغة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি বা ভিডিওর অনুপাত এই জায়গা (16:9) থেকে আলাদা, যেমন 4:3 বা পোর্ট্রেট। কিছু যেন কাটা না পড়ে, তাই পাশে জায়গা ফাঁকা থাকে। ফুল স্ক্রিনে সব দেখা যায়। ফাঁকা জায়গা কেমন দেখাবে?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild oder Video haben ein anderes Seitenverhältnis als dieser Bereich (16:9), etwa 4:3 oder Hochformat. Damit nichts abgeschnitten wird, bleibt daneben Platz frei. In der Vollbildansicht siehst du alles. Wie soll der freie Platz aussehen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image or video has a different aspect ratio than this area (16:9), such as 4:3 or portrait. To avoid cropping, some space stays empty. Full screen shows everything. How should the empty space look?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen o el vídeo tiene una proporción distinta a esta área (16:9), por ejemplo 4:3 o vertical. Para no recortar nada, queda espacio libre. En pantalla completa lo ves todo. ¿Cómo debe verse el espacio libre?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image ou la vidéo a un format différent de cette zone (16:9), par exemple 4:3 ou portrait. Pour ne rien rogner, un espace reste vide. Le plein écran montre tout. À quoi doit ressembler l'espace vide ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि या वीडियो का आकार-अनुपात इस क्षेत्र (16:9) से अलग है, जैसे 4:3 या पोर्ट्रेट। कुछ भी कटे नहीं, इसलिए जगह खाली रहती है। फ़ुल स्क्रीन में सब दिखता है। खाली जगह कैसी दिखे?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片或视频的宽高比与此区域（16:9）不同，例如 4:3 或竖屏。为避免裁剪，旁边会留出空白。全屏可查看完整内容。空白处应如何显示？"
          }
        }
      }
    },
    "cover_ratio_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا لا تملأ الوسائط المساحة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিডিয়া কেন পুরো জায়গা ভরছে না?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum füllt das Medium den Bereich nicht aus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why doesn't the media fill the area?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué el contenido no llena el área?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi le média ne remplit-il pas la zone ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया पूरा क्षेत्र क्यों नहीं भरता?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么媒体没有填满区域？"
          }
        }
      }
    },
