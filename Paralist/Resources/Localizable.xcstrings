    "media_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا صور أو فيديوهات أو تسجيلات صوتية بعد. سجّل شيئًا أو أضفه من الأسفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো ছবি, ভিডিও বা অডিও নেই। কিছু রেকর্ড করুন বা নিচে যোগ করুন।"
          }
        },
        "de": {
