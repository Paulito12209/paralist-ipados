    "empty_tap_inbox": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي مساحة فارغة في القائمة لإضافة ملاحظة جديدة. للمهام والمواعيد وكل شيء آخر، اضغط على «إنشاء» في الأسفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন নোট যোগ করতে তালিকার যেকোনো খালি জায়গায় ট্যাপ করো। কাজ, ইভেন্ট আর বাকি সবকিছুর জন্য নিচে „তৈরি করো“ ট্যাপ করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine freie Stelle in der Liste, um eine neue Notiz anzulegen. Für Aufgaben, Termine und alles andere tippe unten auf „Erstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any empty spot in the list to add a new note. For tasks, events and everything else, tap “Create” below."
