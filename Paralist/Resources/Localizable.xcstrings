    "siri_today_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكر مواعيد اليوم والمهام المستحقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ইভেন্ট ও বাকি কাজগুলো জানায়।"
          }
