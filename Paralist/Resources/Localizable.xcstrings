    "composer_place_none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مشروع أو مجال بعد. سيُحفظ المدخل في الوارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো প্রজেক্ট বা ক্ষেত্র নেই। এন্ট্রিটি ইনবক্সে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Projekt oder Arbeitsbereich. Der Eintrag landet im Eingang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No project or area yet. The entry goes to the inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay proyectos ni áreas. La entrada va a la bandeja de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de projet ni de domaine. L’entrée va dans la boîte de réception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई प्रोजेक्ट या क्षेत्र नहीं। प्रविष्टि इनबॉक्स में जाएगी।"
