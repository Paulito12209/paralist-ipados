    "settings_local_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هذا الجهاز. لا يوجد حساب ولا خادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু এই ডিভাইসেই থাকে। কোনো অ্যাকাউন্ট বা সার্ভার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Es gibt kein Konto und keinen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this device. There is no account and no server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. No hay cuenta ni servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Il n'y a ni compte ni serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी डिवाइस पर रहता है। न कोई खाता है, न कोई सर्वर।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都保存在此设备上。没有账号，也没有服务器。"
          }
        }
      }
    },
