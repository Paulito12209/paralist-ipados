    },
    "feedback_account_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج إلى حساب Discord مجاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর জন্য একটি বিনামূল্যের Discord অ্যাকাউন্ট দরকার।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst dafür ein kostenloses Discord-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need a free Discord account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas una cuenta gratuita de Discord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te faut un compte Discord gratuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए एक मुफ़्त Discord खाता चाहिए।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要一个免费的 Discord 账号。"
          }
        }
      }
    },
    "feedback_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مجتمع Discord يمكنك مشاركة أفكارك والإبلاغ عن الأخطاء والتحدث مع مختبرين آخرين. أرد هناك بنفسي وأخبرك بما وصل إليه اقتراحك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord কমিউনিটিতে আপনি ধারণা শেয়ার করতে, ত্রুটি জানাতে এবং অন্য টেস্টারদের সাথে কথা বলতে পারেন। আমি নিজে সেখানে উত্তর দিই এবং আপনার প্রস্তাবের অগ্রগতি জানাই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Discord-Community teilst du Ideen, meldest Fehler und tauschst dich mit anderen Testern aus. Ich antworte dort selbst und zeige dir, wie es mit deinem Vorschlag weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Discord community you can share ideas, report bugs and talk with other testers. I reply there myself and show you how your suggestion is progressing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la comunidad de Discord puedes compartir ideas, informar de errores y hablar con otros testers. Respondo allí personalmente y te muestro cómo avanza tu propuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la communauté Discord, tu partages tes idées, signales des bugs et échanges avec d'autres testeurs. J'y réponds moi-même et je t'indique où en est ta suggestion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord कम्युनिटी में आप विचार साझा कर सकते हैं, गड़बड़ियाँ बता सकते हैं और दूसरे टेस्टर्स से बात कर सकते हैं। वहाँ सीधे डेवलपर से जवाब मिलता है और आप देख सकते हैं कि आपका सुझाव कहाँ तक पहुँचा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Discord 社区中，你可以分享想法、报告问题，并与其他测试者交流。我会亲自回复，并告诉你建议的进展。"
          }
        }
      }
    },
    "feedback_join_discord": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
