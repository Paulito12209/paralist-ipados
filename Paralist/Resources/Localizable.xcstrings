    "chat_mascot_quip_1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أعد أقدر. حاول لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি আর পারছি না। পরে আবার চেষ্টা করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann nicht mehr. Versuch es später noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’m done for. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo más. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’en peux plus. Réessaie plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझसे अब नहीं होता। बाद में फिर कोशिश करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我撑不住了。晚点再试吧。"
          }
        }
      }
    },
    "chat_mascot_quip_2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أستطيع الكلام الآن. اسألني بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি এখন কথা বলতে পারছি না। একটু পরে আবার জিজ্ঞেস করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann gerade nicht reden. Frag mich gleich noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t talk right now. Ask me again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no puedo hablar. Pregúntame en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas parler là. Redemande-moi dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं अभी बात नहीं कर सकता। थोड़ी देर में फिर पूछें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我现在说不了话。稍后再问我吧。"
          }
        }
      }
    },
    "chat_mascot_quip_3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دائرة قصيرة. نفس عميق، ثم من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্ট সার্কিট। একটা গভীর শ্বাস, তারপর আবার।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzschluss. Einmal durchatmen, dann noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short circuit. One deep breath, then once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortocircuito. Respira hondo y otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Court-circuit. On respire, et on recommence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्ट सर्किट। एक गहरी साँस, फिर दोबारा।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短路了。深呼吸，再来一次。"
          }
        }
      }
    },
    "chat_mascot_quip_4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوف، كان هذا كثيرًا عليّ. سأعود حالًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উফ, এটা আমার জন্য বেশি হয়ে গেল। একটু পরেই ফিরছি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Puh, das war zu viel für mich. Gleich geht’s weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phew, that was too much for me. Back in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uf, eso fue demasiado para mí. Enseguida sigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouf, c’était trop pour moi. Je reviens tout de suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उफ़, यह मेरे लिए बहुत ज़्यादा था। अभी वापस आता हूँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼，这对我来说太难了。马上回来。"
          }
        }
      }
    },
