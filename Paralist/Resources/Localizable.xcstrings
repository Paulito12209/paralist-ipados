    "widget_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الإدخال الذي تختاره بنقرة واحدة، مثل مشروع أو مجال عمل أو إشارة مرجعية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক ট্যাপে আপনার পছন্দের এন্ট্রি খোলে, যেমন একটি প্রজেক্ট, কর্মক্ষেত্র বা বুকমার্ক।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet mit einem Tipp den Eintrag deiner Wahl, etwa ein Projekt, einen Arbeitsbereich oder ein Lesezeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the entry of your choice with one tap, such as a project, an area or a bookmark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre con un toque la entrada que elijas, como un proyecto, un área o un marcador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre d’un geste l’entrée de ton choix, par exemple un projet, un domaine ou un signet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप में अपनी पसंद की प्रविष्टि खोलें, जैसे कोई प्रोजेक्ट, कार्यक्षेत्र या बुकमार्क।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可打开你选择的条目，例如项目、领域或书签。"
          }
        }
      }
    },
    "widget_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس مع الاستمرار الأداة واختر „تعديل الأداة“ لتحديد إدخال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি এন্ট্রি ঠিক করতে উইজেট চেপে ধরে „উইজেট সম্পাদনা“ বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget gedrückt halten und „Widget bearbeiten“ wählen, um einen Eintrag festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the widget and choose “Edit Widget” to pick an entry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el widget y elige “Editar widget” para fijar una entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le widget appuyé et choisis « Modifier le widget » pour définir une entrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रविष्टि तय करने के लिए विजेट को दबाकर रखें और “विजेट संपादित करें” चुनें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住小组件并选择“编辑小组件”来指定一个条目。"
          }
        }
      }
    },
