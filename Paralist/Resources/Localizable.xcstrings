    "chat_error_context": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحادثة طويلة جدًا بالنسبة للنموذج. من الأفضل بدء دردشة جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথনটি মডেলের জন্য খুব লম্বা। নতুন চ্যাট শুরু করাই ভালো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltung ist zu lang für das Modell. Starte am besten einen neuen Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation is too long for the model. Best start a new chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación es demasiado larga para el modelo. Mejor empieza un chat nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation est trop longue pour le modèle. Mieux vaut commencer un nouveau chat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत मॉडल के लिए बहुत लंबी है। बेहतर है नई चैट शुरू करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话对模型来说太长了。最好开始一个新聊天。"
          }
        }
      }
    },
    "chat_error_generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح ذلك. حاول مرة أخرى."
