    "tasks_hint_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المهام المنجزة في القائمة في يوم إنجازها ثم تنتقل إلى أرشيف المجلد. هنا تضبط ذلك بالطريقة الأوضح بالنسبة لك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন কাজ সম্পন্ন হওয়ার দিনে তালিকায় থাকে, তারপর ফোল্ডারের আর্কাইভে চলে যায়। এখানে তুমি এটা নিজের জন্য সবচেয়ে পরিষ্কার মনে হয় এমনভাবে সাজাতে পারো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigte Aufgaben bleiben am Tag der Erledigung in der Liste und wandern danach ins Archiv des Ordners. Hier passt du das so an, wie es für dich am übersichtlichsten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed tasks stay in the list on the day you complete them and then move to the folder's archive. Here you can adjust this to whatever is clearest for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas completadas permanecen en la lista el día en que las completas y después pasan al archivo de la carpeta. Aquí lo ajustas como te resulte más claro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches terminées restent dans la liste le jour de leur achèvement, puis passent aux archives du dossier. Ici, vous réglez cela comme vous le trouvez le plus clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे हुए कार्य पूरा होने के दिन सूची में रहते हैं और फिर फ़ोल्डर के संग्रह में चले जाते हैं। यहाँ इसे वैसे सेट करें जैसे आपको सबसे साफ़ लगे।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的任务在完成当天留在列表中，之后进入文件夹的归档。你可以在这里按自己觉得最清晰的方式调整。"
          }
        }
      }
    },
