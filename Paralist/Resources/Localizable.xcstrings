    "import_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسهل: أنشئ نسخة احتياطية على هاتفك القديم، وأرسلها لنفسك، ثم افتحها هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে সহজ: পুরোনো ফোনে ব্যাকআপ তৈরি করুন, নিজেকে পাঠান এবং এখানে খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am einfachsten: Erstelle auf deinem alten Handy eine Sicherung, schick sie dir und öffne sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easiest way: create a backup on your old phone, send it to yourself and open it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más fácil: crea una copia en tu móvil antiguo, envíatela y ábrela aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus simple : crée une sauvegarde sur ton ancien téléphone, envoie-la-toi et ouvre-la ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे आसान: पुराने फ़ोन पर बैकअप बनाएँ, उसे खुद को भेजें और यहाँ खोलें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最简单的方法：在旧手机上创建备份，发给自己，然后在这里打开。"
          }
        }
      }
    },
