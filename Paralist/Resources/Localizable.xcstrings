        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay imágenes, vídeos ni audios. Graba algo o añádelo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image, vidéo ni audio pour l’instant. Enregistre quelque chose ou ajoute-le en bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई चित्र, वीडियो या ऑडियो नहीं। कुछ रिकॉर्ड करें या नीचे जोड़ें।"
