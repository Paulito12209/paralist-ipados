    "settings_periods_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عندما تقول «صباحًا» أو «ظهرًا» أو «بعد الظهر» أو «مساءً» صوتيًا أو لـ Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কণ্ঠে বা Siri-কে „সকাল“, „দুপুর“, „বিকেল“ বা „সন্ধ্যা“ বললে প্রযোজ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt, wenn du per Sprache oder Siri „morgens“, „mittags“, „nachmittags“ oder „abends“ sagst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you say “morning”, “noon”, “afternoon” or “evening” by voice or to Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando dices «mañana», «mediodía», «tarde» o «noche» por voz o a Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand tu dis « matin », « midi », « après-midi » ou « soir » à la voix ou à Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप आवाज़ से या Siri को „सुबह“, „दोपहर“ या „शाम“ कहते हैं, तब लागू होता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过语音或 Siri 说“早上”“中午”“下午”或“晚上”时使用。"
          }
        }
      }
    },
    "settings_pin_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المثبّت لكل مكان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি স্থানে পিন করা"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angepinnt je Ort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
