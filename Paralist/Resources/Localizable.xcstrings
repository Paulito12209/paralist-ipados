    "chat_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، أنا Pl.AI! اسألني عن مدخلاتك. أجيب مباشرة على جهاز iPad الخاص بك، ولا يغادر أي شيء الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাই, আমি Pl.AI! তোমার এন্ট্রি নিয়ে আমাকে জিজ্ঞেস করো। আমি সরাসরি তোমার iPad-এ উত্তর দিই, কিছুই ডিভাইস ছেড়ে যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, ich bin Pl.AI! Frag mich etwas zu deinen Einträgen. Ich antworte direkt auf deinem iPad, nichts verlässt das Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I’m Pl.AI! Ask me about your entries. I answer right on your iPad, nothing leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola, soy Pl.AI! Pregúntame sobre tus entradas. Respondo directamente en tu iPad, nada sale del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut, je suis Pl.AI ! Pose-moi une question sur tes entrées. Je réponds directement sur ton iPad, rien ne quitte l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते, मैं Pl.AI हूँ! अपनी प्रविष्टियों के बारे में मुझसे पूछें। मैं सीधे आपके iPad पर जवाब देता हूँ, कुछ भी डिवाइस से बाहर नहीं जाता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨，我是 Pl.AI！问我关于你的条目的问题。我直接在你的 iPad 上回答，任何内容都不会离开设备。"
          }
        }
      }
    },
