        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die Termine von heute und fällige Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists today’s events and due tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera los eventos de hoy y las tareas pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énumère les rendez-vous du jour et les tâches à échéance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के कार्यक्रम और देय कार्य बताता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出今天的日程和到期任务。"
          }
        }
      }
    },
