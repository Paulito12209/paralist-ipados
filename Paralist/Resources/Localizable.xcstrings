        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया नोट जोड़ने के लिए सूची में किसी खाली जगह पर टैप करें। कार्य, इवेंट और बाकी सब के लिए नीचे „बनाएँ“ पर टैप करें।"
          }
