    "chat_empty_list": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد دردشات بعد. ابدأ محادثة حول إدخالاتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো চ্যাট নেই। তোমার এন্ট্রি নিয়ে কথোপকথন শুরু করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Chats. Starte eine Unterhaltung über deine Einträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chats yet. Start a conversation about your entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay chats. Empieza una conversación sobre tus entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun chat pour l’instant. Lance une conversation sur tes entrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई चैट नहीं। अपनी प्रविष्टियों के बारे में बातचीत शुरू करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有聊天。开始一段关于你的条目的对话吧。"
          }
        }
      }
    },
    "chat_empty_thread": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل شيئًا عن إدخالاتك أو مهامك أو أسبوعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার এন্ট্রি, কাজ বা সপ্তাহ নিয়ে কিছু জিজ্ঞেস করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag etwas zu deinen Einträgen, Aufgaben oder deiner Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask something about your entries, tasks or your week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta algo sobre tus entradas, tareas o tu semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une question sur tes entrées, tes tâches ou ta semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी प्रविष्टियों, कार्यों या अपने सप्ताह के बारे में कुछ पूछें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问关于你的条目、任务或本周的事情。"
          }
        }
      }
