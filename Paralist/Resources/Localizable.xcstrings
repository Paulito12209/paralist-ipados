    "chat_error_guardrail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع النموذج الإجابة عن ذلك. جرّب صياغة السؤال بطريقة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল এর উত্তর দিতে পারে না। প্রশ্নটি অন্যভাবে করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darauf kann das Modell nicht antworten. Formuliere die Frage anders."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model can’t answer that. Try asking in a different way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no puede responder a eso. Prueba a formular la pregunta de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ne peut pas répondre à cela. Reformule ta question."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल इसका जवाब नहीं दे सकता। सवाल अलग तरीके से पूछें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型无法回答这个问题。请换个方式提问。"
          }
        }
      }
    },
    "chat_error_language": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم النموذج هذه اللغة بعد. غيّر لغة التطبيق أو اسأل بالإنجليزية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল এখনও এই ভাষা সমর্থন করে না। অ্যাপের ভাষা বদলাও বা ইংরেজিতে জিজ্ঞেস করো।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell unterstützt diese Sprache noch nicht. Stell die App-Sprache um oder frag auf Englisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model doesn’t support this language yet. Switch the app language or ask in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo aún no admite este idioma. Cambia el idioma de la app o pregunta en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ne prend pas encore en charge cette langue. Change la langue de l’app ou pose ta question en anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल अभी इस भाषा का समर्थन नहीं करता। ऐप की भाषा बदलें या अंग्रेज़ी में पूछें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型暂不支持这种语言。请切换应用语言或用英语提问。"
          }
        }
      }
    },
