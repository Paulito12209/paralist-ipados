    "feedback_tip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى ذكر جهازك وإصدار iOS وإصدار التطبيق %1$@. هذا يساعدني على إيجاد الأخطاء أسرع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুগ্রহ করে আপনার ডিভাইস, iOS সংস্করণ এবং অ্যাপ সংস্করণ %1$@ জানান। এতে আমি দ্রুত ত্রুটি খুঁজে পাই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne bitte dein Gerät, die iOS-Version und die App-Version %1$@. So finde ich Fehler schneller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please mention your device, iOS version and app version %1$@. That helps me find bugs faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica tu dispositivo, la versión de iOS y la versión de la app %1$@. Así encuentro los errores más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ton appareil, la version d'iOS et la version de l'app %1$@. Je trouve ainsi les bugs plus vite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपना डिवाइस, iOS वर्ज़न और ऐप वर्ज़न %1$@ बताएँ। इससे गड़बड़ियाँ जल्दी मिलती हैं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注明你的设备、iOS 版本和 App 版本 %1$@，这样我能更快找到问题。"
          }
        }
      }
    },
