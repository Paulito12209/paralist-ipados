      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون أسماء يعرض الشريط الرموز فقط ويصبح أضيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম ছাড়া বারে শুধু আইকন দেখায় এবং বারটি সরু হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Namen zeigt die Leiste nur Symbole und wird schmaler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without names the bar shows only icons and gets narrower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin nombres, la barra solo muestra iconos y es más estrecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans noms, la barre n’affiche que des icônes et devient plus étroite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नामों के बिना बार में सिर्फ़ आइकन दिखते हैं और वह पतली हो जाती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示名称时，标签栏只显示图标并变窄。"
