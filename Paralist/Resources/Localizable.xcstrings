    "suggest_settings_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح نموذج صغير على الجهاز أين يناسب المدخل. لا يغادر شيء الـ iPad ولا يُنقل شيء دون موافقتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসের একটি ছোট মডেল পরামর্শ দেয় এন্ট্রিটি কোথায় মানায়। কিছুই iPad-এর বাইরে যায় না, আপনার ছাড়া কিছু সরে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Modell auf dem Gerät schlägt vor, wohin ein Eintrag passt. Nichts verlässt das iPad, nichts wird ohne dich verschoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small on-device model suggests where an entry fits. Nothing leaves the iPad and nothing moves without you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño modelo en el dispositivo sugiere dónde encaja una entrada. Nada sale del iPad y nada se mueve sin ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit modèle sur l’appareil suggère où classer une entrée. Rien ne quitte l’iPad et rien n’est déplacé sans toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर एक छोटा मॉडल सुझाता है कि प्रविष्टि कहाँ फिट होती है। कुछ भी iPad से बाहर नहीं जाता और आपके बिना कुछ नहीं हटता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上的小模型会建议条目应归入哪里。数据不会离开iPad，未经你确认不会移动。"
          }
        }
      }
    },
